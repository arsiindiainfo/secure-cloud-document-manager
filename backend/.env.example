#--------------------------------------------------------------------
# Environment Configuration Template
#
# Copy this file to `.env` and fill in real values for local development.
# `.env` is git-ignored (§5) — only this template is committed. When running
# via `docker compose up` (infrastructure/docker-compose.yml), these values
# are injected as container environment variables instead and this file is
# not read — it exists for the `php spark serve` (no Docker) workflow and as
# living documentation of every configurable key the app reads via env().
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = 127.0.0.1
database.default.database = scdm
database.default.username = scdm
database.default.password = scdm
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3309

# Used by `composer test` — a separate schema so feature tests never touch
# development data. Point this at the same MySQL server, a different schema.
database.tests.hostname = 127.0.0.1
database.tests.database = scdm_test
database.tests.username = scdm
database.tests.password = scdm
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =
database.tests.charset = utf8mb4
database.tests.DBCollat = utf8mb4_general_ci
database.tests.port = 3309

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate with: php spark key:generate
encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

#--------------------------------------------------------------------
# AUTH (§5, §15) — JWT access/refresh tokens + internal HMAC callback secret
#--------------------------------------------------------------------

# Any long random string for local dev; a real secret manager value in prod.
auth.jwtSecret = local-dev-jwt-secret-do-not-use-in-production
auth.accessTokenTtl = 900
auth.refreshTokenTtl = 1209600
# Shared only with the Lambda worker — verifies POST /internal/processing-callback (§9.3).
auth.internalHmacSecret = local-dev-hmac-secret-do-not-use-in-production

#--------------------------------------------------------------------
# AWS / S3 (§10, §28) — presigned URL generation via S3Service
#--------------------------------------------------------------------

aws.region = us-east-1
# Point at LocalStack for local dev; leave blank to use real AWS.
aws.endpoint = http://127.0.0.1:4566
aws.key = test
aws.secret = test
aws.documentsBucket = scdm-documents-local
aws.spaBucket = scdm-spa-local
aws.presignTtlSeconds = 300

#--------------------------------------------------------------------
# MAIL (user-invite emails, §15) — Mailhog in local dev
#--------------------------------------------------------------------

email.protocol = smtp
email.SMTPHost = 127.0.0.1
email.SMTPPort = 1026
# Mailhog doesn't speak STARTTLS — leave crypto empty for local dev.
email.SMTPCrypto = ''
email.fromEmail = no-reply@arsiindiainfo.local
email.fromName = "Secure Cloud Document Manager"
