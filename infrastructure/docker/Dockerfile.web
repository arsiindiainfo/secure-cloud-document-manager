# Production-parity build of the React SPA, served by nginx.
# Local frontend development uses `npm run dev` (Vite HMR) directly on the
# host instead — this container exists to demonstrate/verify the built-static
# artifact the AWS SPA bucket + CloudFront would serve (§28 of the plan).
# Build context is the repo root (see infrastructure/docker-compose.yml).
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/. .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
