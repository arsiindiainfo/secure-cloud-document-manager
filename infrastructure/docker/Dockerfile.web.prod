# Production build — same as Dockerfile.web but using the production CSP
# (real S3 domain instead of LocalStack) and explicit build ARGs for the
# VITE_ variables, since Vite doesn't reliably read a committed .env file
# during a Docker build (learned the hard way on another project in this
# same account — passing them as ARG/ENV before `npm run build` is the
# proven-working mechanism).
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/. .
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ARG VITE_RECAPTCHA_SITE_KEY=
ENV VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.web.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
